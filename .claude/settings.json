{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": true,
  "prefersReducedMotion": true,
  "statusLine": {
    "type": "command",
    "command": "bash .claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "python-dev@claude-plugins-official": true,
    "tdd-core@claude-plugins-official": true,
    "security-audit@claude-plugins-official": true,
    "commit-helper@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "AskUserQuestion",
      "Bash(date:*)",
      "Bash(git add:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git log --grep:*)",
      "Bash(git rev-list:*)",
      "Bash(jq:*)",
      "Bash(make validate)",
      "Bash(make quick_validate)",
      "Bash(make ci)",
      "Bash(make test)",
      "Bash(make test_coverage)",
      "Bash(make audit)",
      "Bash(make help)",
      "Bash(tree:*)",
      "Bash(uv sync --frozen)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Edit(docs/)",
      "Edit(tests/)",
      "Edit(src/**)",
      "mcp__ide__getDiagnostics",
      "Read(.claude/skills/)",
      "Read(.claude/rules/)",
      "SlashCommand",
      "Skill",
      "Bash(git commit:*)",
      "Bash(lychee *)",
      "Bash(gh run watch *)",
      "Bash(gh repo list *)",
      "Bash(rtk ls *)",
      "Bash(rtk read *)",
      "Bash(ffprobe *)",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation"
    ],
    "deny": [
      "Bash(awk:*)",
      "Bash(source:*)",
      "Bash(touch:*)",
      "Edit(.env)",
      "Read(.env)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git clean:*)",
      "Bash(git reset:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(Makefile)",
      "Edit(pyproject.toml)",
      "Edit(README.md)",
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude <noreply@anthropic.com>"
  }
}
